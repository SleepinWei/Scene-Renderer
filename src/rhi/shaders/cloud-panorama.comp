#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
#include "cloud-parameters.glsl"
#include "cloud-intersection.glsl"
#include "cloud-volume-sampling.glsl"
layout(set=0,binding=1) uniform sampler2D cloudSkyIrradiance;
layout(set=1,binding=0) uniform sampler2D cloudNoiseAtlas;
layout(set=1,binding=1) uniform sampler2D cloudWeather;
layout(set=1,binding=2) uniform sampler2D cloudVoxels;
layout(set=1,binding=3) uniform sampler2D cloudVoxelLight;
layout(set=1,binding=4) uniform sampler2D cloudSkyRadiance;
layout(set=1,binding=5,rgba16f) writeonly uniform image2D cloudPanorama;
#include "cloud-density.glsl"
#include "sky-mapping.glsl"
float phaseHG(float mu,float g){return (1.-g*g)/(12.5663706*pow(max(1.+g*g-2.*g*mu,.001),1.5));}
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(cloudPanorama);if(any(greaterThanEqual(p,size)))return;
    vec2 uv=(vec2(p)+.5)/vec2(size);float theta=uv.y*3.14159265,phi=uv.x*6.2831853;
    vec3 ray=vec3(sin(theta)*sin(phi),cos(theta),-sin(theta)*cos(phi)),background=sampleSkyLut(cloudSkyRadiance,ray);
    vec2 interval=cloudInterval(ray,cloudShape.w);float T=1.;vec3 L=vec3(0),ambient=sampleSkyLut(cloudSkyIrradiance,vec3(0,1,0))/3.14159265;
    float phase=.85*phaseHG(dot(ray,cloudSun.xyz),.65)+.15*phaseHG(dot(ray,cloudSun.xyz),-.25);
    if(interval.y>interval.x){float ds=(interval.y-interval.x)/float(cloudQuality.x);
        for(int i=0;i<cloudQuality.x;++i){vec3 point=cloudCameraTime.xyz+ray*(interval.x+(float(i)+.5)*ds),local=cloudVolumeUV(point);
            bool voxel=cloudVolumeCenterMode.w>.5;float density=voxel?cloudCachedDensity(cloudVolumeSample(cloudVoxels,local,int(cloudVolumeQuality.x))):cloudDensity(point);
            if(voxel&&density>0.&&density<.8){float t=interval.x+(float(i)+.5)*ds,detailScale=max(cloudShape.x*.22,100.),detailCell=detailScale/24.;
                float detailWeight=1.-smoothstep(detailCell*.75,detailCell*2.,t*6.2831853*sin(theta)/float(size.x));
                density*=clamp(1.-(1.-cloudNoiseSample((point-vec3(cloudAdvection.x,0,cloudAdvection.y))/detailScale).y)*cloudShape.z*detailWeight,0.,1.);}
            if(density<=0.)continue;float tau=0.;
            if(voxel)tau=cloudCachedTau(cloudVoxelLight,local);
            else for(int j=0;j<cloudQuality.y;++j){float a=float(j)/float(cloudQuality.y),b=float(j+1)/float(cloudQuality.y),distance=min(cloudLayer.y*3.,6000.);
                tau+=cloudDensity(point+cloudSun.xyz*((a*a+b*b)*.5*distance))*cloudLayer.w*(b*b-a*a)*distance;}
            vec3 lighting=ambient*(voxel?.3+.7*clamp(local.y,0.,1.):.5+.5*smoothstep(0.,1.,(point.y-cloudPlanet.y-cloudLayer.x)/cloudLayer.y))+cloudSunColor.rgb*(phase*exp(-tau)+.045*exp(-.25*tau)+.015*exp(-.06*tau));
            if(voxel){vec3 flashPoint=(local-vec3(.5,.6,.5))*cloudVolumeSize.xyz;float flash=cloudVolumeQuality.w*pow(max(cos(cloudCameraTime.w*1.57079633),0.),64.);lighting+=vec3(.55,.7,1)*flash*exp(-dot(flashPoint,flashPoint)/800000.);}
            float segment=exp(-density*cloudLayer.w*ds);L+=T*(1.-segment)*lighting*.98;T*=segment;if(T<.01)break;}}
    imageStore(cloudPanorama,p,vec4(min(max(L+T*background,vec3(0)),vec3(65000)),T));
}
