#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
#include "cloud-parameters.glsl"
layout(set=1,binding=0) uniform sampler2D cloudNoiseAtlas;
layout(set=1,binding=1,rgba8) writeonly uniform image2D cloudVoxels;
#include "cloud-atlas-noise.glsl"
float ellipsoid(vec3 p,vec3 center,vec3 radius){return 1.-length((p-center)/radius);}
void main(){
    ivec2 at=ivec2(gl_GlobalInvocationID.xy),size=imageSize(cloudVoxels);if(any(greaterThanEqual(at,size)))return;
    int n=int(cloudVolumeQuality.x),columns=n==128?16:8;ivec2 tile=at/(n+2),p=at%(n+2)-1;
    int z=tile.y*columns+tile.x;vec3 uv=(vec3(p,z)+.5)/float(n),q=uv*2.-1.;
    float d=0.;
    if(all(greaterThanEqual(uv,vec3(0))) && all(lessThanEqual(uv,vec3(1)))){
        vec3 point=cloudVolumeCenterMode.xyz+(uv-.5)*cloudVolumeSize.xyz;
        vec3 turbulence=vec3(cloudNoiseSample(point/(cloudShape.x*.38)).x,
            cloudNoiseSample(point/(cloudShape.x*.38)+vec3(.31,.67,.13)).x,
            cloudNoiseSample(point/(cloudShape.x*.38)+vec3(.73,.11,.47)).x);
        q+=(turbulence-.42)*.24;
        if(cloudVolumeSize.w>.01){
            float a=q.y*4.*cloudVolumeSize.w;mat2 spin=mat2(cos(a),sin(a),-sin(a),cos(a));q.xz=spin*q.xz;
            float funnel=ellipsoid(q,vec3(0,-.1,0),vec3(.25+.3*(q.y+.5),.85,.30+.15*(q.y+.5)));
            d=max(funnel,ellipsoid(q,vec3(0,.6,0),vec3(.80,.35,.80)));
        }else{
            d=max(ellipsoid(q,vec3(-.38,-.1,.15),vec3(.46,.45,.56)),ellipsoid(q,vec3(.28,.05,-.22),vec3(.48,.52,.53)));
            d=max(d,ellipsoid(q,vec3(-.1,.48,-.25),vec3(.48,.44,.48)));
            d=max(d,ellipsoid(q,vec3(.50,-.35,.45),vec3(.33,.35,.40)));
            d=max(d,ellipsoid(q,vec3(-.58,.36,-.38),vec3(.30,.35,.36)));
        }
        vec2 noise=cloudNoiseSample(point/(cloudShape.x*.45));
        d=clamp((d+(noise.x-.5)*.28-(1.-cloudLayer.z)*.3-(1.-noise.y)*cloudShape.z*.10)*8.,0.,1.);
        if(cloudLayer.z<=0. || cloudLayer.w<=0.)d=0.;
    }
    imageStore(cloudVoxels,at,vec4(d,d*d,0,1));
}
