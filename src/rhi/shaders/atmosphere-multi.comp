#version 450
#extension GL_GOOGLE_include_directive : require
#include "atmosphere-common.glsl"
layout(local_size_x=4,local_size_y=4) in;
layout(set=1,binding=0,rgba32f) writeonly uniform image2D multiLut;
layout(set=1,binding=1) uniform sampler2D transmittance;
// Hillaire's isotropic higher-order approximation. Stored per unit solar irradiance.
vec3 integrate(float r,float mu,float muSun,float nu,out vec3 feedback) {
    bool ground=intersectsGround(r,mu);float length=ground?distanceGround(r,mu):distanceTop(r,mu);
    vec3 T=vec3(1),radiance=vec3(0);feedback=vec3(0);
    const int steps=32;
    for(int i=0;i<steps;++i) {
        float a=float(i)/float(steps),b=float(i+1)/float(steps),start=a*a*length,end=b*b*length,t=(start+end)*.5;
        float ri=radiusAlongRay(r,mu,t),muSunI=clamp((r*muSun+t*nu)/ri,-1.0,1.0);
        vec3 rayleigh,mie,extinction;coefficients(ri-atmosphere.bottom_radius,rayleigh,mie,extinction);
        vec3 weight=T*segmentWeight(extinction,end-start),scattering=rayleigh+mie;
        radiance+=weight*scattering*sunTransmission(transmittance,ri,muSunI)/(4.0*ATM_PI);
        feedback+=weight*scattering;T*=exp(-extinction*(end-start));
    }
    if(ground) {
        float ri=radiusAlongRay(r,mu,length),muSunI=clamp((r*muSun+length*nu)/ri,-1.0,1.0);
        radiance+=T*lutSettings.x*max(muSunI,0.0)*sunTransmission(transmittance,ri,muSunI)/ATM_PI;
        feedback+=T*lutSettings.x;
    }
    return radiance;
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(pixel,dimensions.xy)))return;
    vec2 x=vec2(pixel)/vec2(dimensions.xy-1);float muSun=2.0*x.x-1.0;
    float r=atmosphere.bottom_radius+max(.001,x.y*(atmosphere.top_radius-atmosphere.bottom_radius-.001));
    vec3 sun=vec3(sqrt(max(0.0,1.0-muSun*muSun)),muSun,0),sum=vec3(0),feedback=vec3(0);
    for(int i=0;i<8;++i)for(int j=0;j<8;++j) {
        // Uniform solid angle; all 64 directions are distinct.
        float mu=1.0-2.0*(float(i)+.5)/8.0,phi=2.0*ATM_PI*(float(j)+.5)/8.0;
        vec3 direction=vec3(sqrt(1.0-mu*mu)*cos(phi),mu,sqrt(1.0-mu*mu)*sin(phi)),f;
        sum+=integrate(r,mu,muSun,dot(direction,sun),f);feedback+=f;
    }
    sum/=64.0;feedback/=64.0;
    imageStore(multiLut,pixel,vec4(sum/max(vec3(1.0)-feedback,vec3(.001)),1));
}
