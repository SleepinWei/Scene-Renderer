#version 450
#extension GL_GOOGLE_include_directive : require
#include "atmosphere-common.glsl"
#include "sky-mapping.glsl"
layout(local_size_x=8,local_size_y=4) in;
layout(set=1,binding=0,rgba32f) writeonly uniform image2D irradiance;
layout(set=1,binding=1) uniform sampler2D skyViewLut;
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(pixel,dimensions.xy)))return;
    vec3 N=skyTexelDirection(pixel,dimensions.xy),helper=abs(N.y)<.99?vec3(0,1,0):vec3(1,0,0);
    vec3 T=normalize(cross(helper,N)),B=cross(N,T),sum=vec3(0);
    for(int i=0;i<8;++i)for(int j=0;j<8;++j) {
        float u=(float(i)+.5)/8.0,phi=2.0*ATM_PI*(float(j)+.5)/8.0;
        vec3 direction=T*(sqrt(u)*cos(phi))+B*(sqrt(u)*sin(phi))+N*sqrt(1.0-u);
        sum+=sampleSkyLut(skyViewLut,direction);
    }
    // Cosine-weighted mean stores E/pi, matching PBR and RSM consumers.
    imageStore(irradiance,pixel,vec4(sum/64.0,1));
}
