#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
#include "pt-integrator.glsl"
vec3 cameraDirection(vec2 uv){vec4 far=p.inverseProjection*vec4(uv.x*2-1,1-uv.y*2,1,1);return unit(far.xyz/far.w-p.camera.xyz,vec3(0,0,-1));}
void main(){
    uvec2 xy=gl_GlobalInvocationID.xy;if(any(greaterThanEqual(xy,p.dimensions.xy)))return;uint index=xy.y*p.dimensions.x+xy.x;Pixel state=pixels[index];rayEpsilon=p.guideSettings.w>0?1e-6:EPS;rayCount=0u;volumeEvents=0u;guideEvents=0u;cacheEvents=0u;activeGuide=0xffffffffu;guideFraction=0;environmentFraction=0;
    if(p.control.z==1u){Hit hit;if(intersectScene(state.albedo.xyz,state.normal.xyz,INF,hit)){Surface s=makeSurface(hit,state.albedo.xyz,state.normal.xyz);state.mean=vec4(s.position,hit.distance);state.m2=vec4(s.albedo,1);state.normal=vec4(s.n,1);}else state.m2=vec4(0);pixels[index]=state;return;}
    if(p.control.z==2u){uint seed=ptHash(p.control.y^ptHash(floatBitsToUint(p.camera.w))^ptHash(index));state.mean=vec4(sobol(seed,index,0u),sobol(seed,index,258u),sobol(seed,index,514u),sobol(seed,index,24578u));pixels[index]=state;return;}
    if(state.stats.y>=2u)return;
    if(state.stats.x==0u){Hit hit;vec3 d=cameraDirection((vec2(xy)+.5)/vec2(p.dimensions.xy));if(intersectScene(p.camera.xyz,d,INF,hit)){Surface s=makeSurface(hit,p.camera.xyz,d);state.albedo=vec4(s.albedo,p.photonControl.x!=0u?0:1);state.normal=vec4(s.n,0);}}
    pixelSeed=ptHash(p.control.y^ptHash(floatBitsToUint(p.camera.w))^ptHash(index));
    if(p.control.z==3u)pixelSeed=ptHash(pixelSeed^0x68bc21ebu);
    for(uint i=p.dimensions.z;i<p.dimensions.w;++i){sampleIndex=i;dimension=0u;activeGuide=0xffffffffu;guideFraction=0;environmentFraction=0;fallbackState=ptHash(pixelSeed^ptHash(i));float jx=randomValue(),jy=randomValue();vec2 jitter=vec2(jx,jy);vec3 value=tracePath(p.camera.xyz,cameraDirection((vec2(xy)+jitter)/vec2(p.dimensions.xy)));
        if(any(isnan(value))||any(isinf(value))){++state.stats.w;continue;}++state.stats.x;vec3 delta=value-state.mean.xyz;state.mean.xyz+=delta/float(state.stats.x);if(p.photonControl.x!=0u){state.mean.w+=(pathCaustics.x-state.mean.w)/float(state.stats.x);state.m2.w+=(pathCaustics.y-state.m2.w)/float(state.stats.x);state.albedo.w+=(pathCaustics.z-state.albedo.w)/float(state.stats.x);}state.m2.xyz+=delta*(value-state.mean.xyz);}
    uint n=state.stats.x;if(p.adaptive.x!=0u&&n>=min(p.adaptive.y,p.adaptive.z)&&n>1u){vec3 error=sqrt(max(state.m2.xyz,vec3(0))/float(n-1u)/float(n))*1.96;vec3 threshold=vec3(p.settings.z)+abs(state.mean.xyz)*p.settings.y;state.stats.y=all(lessThanEqual(error,threshold))?state.stats.y+1u:0u;}
    if(p.photonControl.x==0u){state.mean.w+=float(guideEvents);state.m2.w+=float(cacheEvents);}state.stats.z+=rayCount;state.normal.w+=float(volumeEvents);pixels[index]=state;
}
