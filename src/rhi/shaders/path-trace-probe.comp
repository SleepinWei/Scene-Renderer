#version 450
#extension GL_GOOGLE_include_directive : require
#define PT_PROBE_ENTRY 1
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
#include "pt-integrator.glsl"
vec3 probeDirection(uvec2 xy){uint n=p.dimensions.y,face=xy.x/n;vec2 q=(vec2(xy.x%n,xy.y)+.5)/float(n)*2.-1.;
    if(face==0u)return normalize(vec3(1,q.y,-q.x));if(face==1u)return normalize(vec3(-1,q.y,q.x));
    if(face==2u)return normalize(vec3(q.x,1,-q.y));if(face==3u)return normalize(vec3(q.x,-1,q.y));
    if(face==4u)return normalize(vec3(q.x,q.y,1));return normalize(vec3(-q.x,q.y,-1));}
void main(){
    uvec2 xy=gl_GlobalInvocationID.xy;if(any(greaterThanEqual(xy,p.dimensions.xy)))return;uint index=xy.y*p.dimensions.x+xy.x;
    rayEpsilon=p.guideSettings.w>0?1e-6:EPS;rayCount=0u;volumeEvents=0u;guideEvents=0u;cacheEvents=0u;activeGuide=0xffffffffu;guideFraction=0;environmentFraction=0;
    vec3 d=probeDirection(xy);float distance=0.;bool back=false;Hit first;
    if(intersectScene(p.camera.xyz,d,INF,first)){Surface s=makeSurface(first,p.camera.xyz,d);distance=min(first.distance,p.photonSettings.w);back=!s.frontFace&&materials[instances[first.instance].info.y].extra.y==0u;}
    Pixel state;state.mean=vec4(0);state.m2=vec4(0);state.stats=uvec4(0);state.albedo=vec4(0);state.normal=vec4(0);
    pixelSeed=ptHash(p.control.y^ptHash(index));
    if(!back)for(uint i=p.dimensions.z;i<p.dimensions.w;++i){sampleIndex=i;dimension=0u;activeGuide=0xffffffffu;guideFraction=0;environmentFraction=0;fallbackState=ptHash(pixelSeed^ptHash(i));randomValue();randomValue();vec3 value=tracePath(p.camera.xyz,d);
        if(any(isnan(value))||any(isinf(value))){++state.stats.w;continue;}++state.stats.x;vec3 delta=value-state.mean.rgb;state.mean.rgb+=delta/float(state.stats.x);state.m2.rgb+=delta*(value-state.mean.rgb);}
    state.mean.w=back?-distance:distance;state.stats.z=rayCount;pixels[index]=state;
}
