#version 450
#extension GL_GOOGLE_include_directive : require
#include "aerial-parameters.glsl"
layout(set=0,binding=1,std140) uniform AirFogParameters {mat4 airInverseVP;vec4 airCamera;vec4 airSettings;vec4 airColour;vec4 airAerial;};
layout(set=1,binding=0,rgba16f) writeonly uniform image2D aerialRadiance;
layout(set=1,binding=1,rgba16f) writeonly uniform image2D aerialTransmission;
layout(set=1,binding=4,rgba16f) writeonly uniform image2D aerialSolarLoss;
layout(set=1,binding=2) uniform sampler2D aerialTransmittance;
layout(set=1,binding=3) uniform sampler2D aerialMultiple;
#define SHADOW_SET 0
#define SHADOW_BINDING 2
#include "shadow-data.glsl"
layout(set=0,binding=3) uniform sampler2D aerialShadowAtlas;
#include "aerial-shadow.glsl"
#include "aerial-integrate.glsl"
layout(local_size_x=8,local_size_y=8) in;
void main(){
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);if(pixel.x>=32||pixel.y>=1024)return;
    int slice=pixel.y/32;vec2 uv=(vec2(pixel.x,pixel.y%32)+.5)/32.;
    vec4 point=airInverseVP*vec4(uv*vec2(2,-2)+vec2(-1,1),.999999,1);
    vec3 direction=normalize(point.xyz/point.w);
    float depth=float(slice)/31.;vec3 L,T,solarLoss;
    integrateAerial(airCamera.xyz,direction,depth*depth*aerialDomain.z,-1e30,L,T,solarLoss);
    imageStore(aerialSolarLoss,pixel,vec4(solarLoss,1));
    imageStore(aerialRadiance,pixel,vec4(L,1));imageStore(aerialTransmission,pixel,vec4(T,1));
}
