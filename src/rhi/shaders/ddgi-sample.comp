#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
#include "ddgi-parameters.glsl"
layout(set=0,binding=1,std430) readonly buffer DdgiField {vec4 ddgiField[];};
layout(set=0,binding=2,std430) readonly buffer QueryPositions {vec4 queryPositions[];};
layout(set=0,binding=3,std430) readonly buffer QueryNormals {vec4 queryNormals[];};
layout(set=0,binding=4,std430) buffer QueryResults {vec4 queryResults[];};
#include "ddgi-query.glsl"
void main(){uint i=gl_GlobalInvocationID.x;if(i>=uint(ddgiProbe.w))return;vec3 p=queryPositions[i].xyz,n=normalize(queryNormals[i].xyz);queryResults[i]=ddgiQuery(p,n,n);}
