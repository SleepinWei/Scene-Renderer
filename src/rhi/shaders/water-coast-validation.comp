#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8) in;
layout(set=0,binding=0,std140) uniform CoastProbe {mat4 coastInverse;vec4 coastBedInfo;vec4 probePatch;};
layout(set=0,binding=1) uniform sampler2D probeState;
layout(set=0,binding=2,rgba32f) writeonly uniform image2D probeOutput;
#include "water-coast.glsl"
void main(){int i=int(gl_GlobalInvocationID.x);if(i>=8)return;
    // Wet/dry interpolation near x=0, finite-bed boundaries x=+/-1,
    // and camera-patch borders x=+/-8 are deliberately independent.
    float x[8]=float[8](-.5,-.01,0.,.01,.5,-1.25,1.25,9.);
    imageStore(probeOutput,ivec2(i,0),vec4(coastHeight(vec2(x[i],0),.125,probeState,probePatch,0.,1.),0,0,1));}
