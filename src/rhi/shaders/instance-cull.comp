#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
#include "instance-cull-parameters.glsl"
bool outside(mat4 transform,vec4 plane,vec3 centre,vec3 extent){vec4 local=transpose(transform)*plane;return dot(local.xyz,centre)+local.w+dot(abs(local.xyz),extent)<0.;}
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=min(inputArgs[1],uint(minimum.w)))return;
    mat4 transform=clip*inputPoses[i];vec3 centre=(minimum.xyz+maximum.xyz)*.5,extent=(maximum.xyz-minimum.xyz)*.5;
    if(outside(transform,vec4(1,0,0,1.+guard.x),centre,extent)||outside(transform,vec4(-1,0,0,1.+guard.x),centre,extent)||
       outside(transform,vec4(0,1,0,1.+guard.y),centre,extent)||outside(transform,vec4(0,-1,0,1.+guard.y),centre,extent)||
       outside(transform,vec4(0,0,1,0),centre,extent)||outside(transform,vec4(0,0,-1,1),centre,extent))return;
    uint at=atomicAdd(outputArgs[1],1u);outputPoses[at]=inputPoses[i];
}
