#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=16,local_size_y=16,local_size_z=1)in;
#include "grass-placement.glsl"
layout(set=1,binding=1,std430) writeonly buffer OutPose {mat4 outPose[];};
layout(set=1,binding=2,std430) buffer GrassIndirect {uint indexCount;uint instanceCount;uint firstIndex;int baseVertex;uint firstInstance;};
layout(set=1,binding=3,std430) readonly buffer GrassCandidates {uint candidateCount;};
void generate(uint sampleIndex){
    vec3 position;uint seed;float growth;if(!candidate(sampleIndex,position,seed,growth))return;
    float budget=candidateCount<=uint(grassSettings.y)?1.:.9*grassSettings.y/float(candidateCount);
    if(random(seed,5u)>budget)return;
    float angle=6.2831853*random(seed,6u),c=cos(angle),s=sin(angle);
    float h=shape.x*growth,w=shape.y*growth;
    float bend=.16*sin(grassSettings.x*1.7+position.x*.3+position.z*.2)*h;
    mat4 model=mat4(c*w,0,-s*w,0,bend,h,0,0,s*w,0,c*w,0,position,1);
    uint index=atomicAdd(instanceCount,1),capacity=uint(grassSettings.y);
    if(index>=capacity){atomicMin(instanceCount,capacity);return;}outPose[index]=model;
}

void main(){if(!leafEligible())return;preparePatch();uint blocks=uint(controls.z)/2u;for(uint i=0;i<blocks*blocks;i++)generate(i);}
