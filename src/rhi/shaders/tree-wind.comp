#version 450
layout(local_size_x=64)in;
layout(set=0,binding=0,std140) uniform TreeClock{vec4 clock;vec4 velocity;vec4 geometry;};
layout(set=0,binding=1,std430) readonly buffer TreeRest{float rest[];};
layout(set=0,binding=2,std430) readonly buffer TreePivots{vec4 pivots[];};
layout(set=0,binding=3,std430) buffer TreeDeformed{float deformed[];};
layout(set=0,binding=4,std430) writeonly buffer TreePrevious{float previous[];};
vec3 rotateTree(vec3 p,vec3 axis,float a){return p*cos(a)+cross(axis,p)*sin(a)+axis*dot(axis,p)*(1.-cos(a));}
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=uint(geometry.x))return;uint at=i*8;
    vec3 p=vec3(rest[at],rest[at+1],rest[at+2]),n=vec3(rest[at+3],rest[at+4],rest[at+5]);
    float speed=length(velocity.xy);
    if(speed>1e-6){vec2 direction=velocity.xy/speed;vec3 axis=vec3(direction.y,0,-direction.x);float strength=speed/(10.+speed);
        vec4 branch=pivots[i*3],twig=pivots[i*3+1],leaf=pivots[i*3+2];
        float a=.12*strength*clock.z*branch.w*sin(clock.x*.85+clock.y+dot(branch.xyz,vec3(17,7,13)));
        float b=.20*strength*clock.z*twig.w*sin(clock.x*1.9+clock.y+dot(twig.xyz,vec3(31,19,23)));
        float c=.55*strength*clock.w*leaf.w*sin(clock.x*7.3+clock.y+dot(leaf.xyz,vec3(131,77,113)));
        if(leaf.w>0){vec3 leafAxis=normalize(vec3(1,.3,.6));p=leaf.xyz+rotateTree(p-leaf.xyz,leafAxis,c);n=rotateTree(n,leafAxis,c);}
        p=twig.xyz+rotateTree(p-twig.xyz,axis,b);n=rotateTree(n,axis,b);
        p=branch.xyz+rotateTree(p-branch.xyz,axis,a);n=rotateTree(n,axis,a);
        float sway=.035*strength*clock.z*(.7+.3*sin(clock.x*.65+clock.y));float y=max(p.y,0.);
        p.xz+=direction*sway*y*y;n.y-=2.*y*sway*dot(direction,n.xz);n=normalize(n);
    }
    for(uint k=0;k<8;k++){float value=k<3?p[k]:k<6?n[k-3]:rest[at+k];previous[at+k]=geometry.y>.5?deformed[at+k]:value;deformed[at+k]=value;}
}
