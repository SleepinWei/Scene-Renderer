#version 450
#extension GL_GOOGLE_include_directive : require
#include "geometry-cull-parameters.glsl"
layout(local_size_x=128) in;
layout(set=1,binding=4,std430) buffer CullGroups {uint groupResults[];};
layout(set=1,binding=6,std430) writeonly buffer CullOutputArguments {uint outputCount;uint outputInstances;uint outputFirst;int outputBase;uint outputInstance;};
layout(set=1,binding=2,std430) readonly buffer CullInputArguments {uint inputCount;uint inputInstances;uint inputFirst;int inputBase;uint inputInstance;};
shared uint prefix[128];
void main(){
    uint lane=gl_LocalInvocationIndex;
    uint capacity=cullCounts.x*3u;
    uint activeGroups=cullCounts.z!=0u?(inputInstances!=0u?(min(inputCount,capacity-min(inputFirst,capacity))/3u+63u)/64u:0u):cullCounts.w;
    uint chunk=(activeGroups+127u)/128u,first=lane*chunk,last=min(first+chunk,activeGroups),sum=0u;
    for(uint group=first;group<last;++group)sum+=groupResults[group*2u];
    prefix[lane]=sum;barrier();
    for(uint step=1u;step<128u;step<<=1u){
        uint add=lane>=step?prefix[lane-step]:0u;barrier();
        prefix[lane]+=add;barrier();
    }
    uint offset=lane==0u?0u:prefix[lane-1u];
    for(uint group=first;group<last;++group){groupResults[group*2u+1u]=offset;offset+=groupResults[group*2u];}
    if(lane==127u){outputCount=prefix[127]*3u;outputInstances=1u;outputFirst=0u;
        outputBase=cullCounts.z!=0u?inputBase:0;outputInstance=0u;}
}
