#version 450
#extension GL_GOOGLE_include_directive : require
#include "atmosphere-common.glsl"
#include "sky-mapping.glsl"
layout(local_size_x=8,local_size_y=4) in;
layout(set=1,binding=0,rgba32f) writeonly uniform image2D skyViewLut;
layout(set=1,binding=1) uniform sampler2D transmittance;
layout(set=1,binding=2) uniform sampler2D multipleScattering;
vec3 sampleMultiple(float r,float muSun) {
    vec2 size=vec2(textureSize(multipleScattering,0)),x=vec2(muSun*.5+.5,(r-atmosphere.bottom_radius)/(atmosphere.top_radius-atmosphere.bottom_radius));
    return texture(multipleScattering,.5/size+clamp(x,0.0,1.0)*(1.0-1.0/size)).rgb;
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(pixel,dimensions.xy)))return;
    vec3 direction=skyTexelDirection(pixel,dimensions.xy),sun=normalize(sunDirectionHeight.xyz);
    float r=atmosphere.bottom_radius+sunDirectionHeight.w,mu=direction.y,muSun=sun.y,nu=dot(direction,sun);
    float length=intersectsGround(r,mu)?distanceGround(r,mu):distanceTop(r,mu);vec3 T=vec3(1),radiance=vec3(0);
    const int steps=48;
    for(int i=0;i<steps;++i) {
        float a=float(i)/float(steps),b=float(i+1)/float(steps),start=a*a*length,end=b*b*length,t=(start+end)*.5;
        float ri=radiusAlongRay(r,mu,t),muSunI=clamp((r*muSun+t*nu)/ri,-1.0,1.0);
        vec3 rayleigh,mie,extinction;coefficients(ri-atmosphere.bottom_radius,rayleigh,mie,extinction);
        vec3 source=(rayleigh*rayleighPhase(nu)+mie*miePhase(nu))*sunTransmission(transmittance,ri,muSunI);
        source+=(rayleigh+mie)*sampleMultiple(ri,muSunI)*solarColorMultiple.w;
        radiance+=T*segmentWeight(extinction,end-start)*source;T*=exp(-extinction*(end-start));
    }
    imageStore(skyViewLut,pixel,vec4(max(radiance*solarColorMultiple.rgb,vec3(0)),1));
}
