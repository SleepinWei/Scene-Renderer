#version 450
layout(local_size_x=8) in;
layout(set=0,binding=0,std430) readonly buffer InputData { vec2 values[8]; } inputData;
layout(set=0,binding=1,std430) writeonly buffer OutputData { vec2 values[8]; } outputData;
layout(set=0,binding=2,std140) uniform FFTParameters { ivec4 stageData; };
uint reverseThree(uint i) { return ((i&1u)<<2u)|(i&2u)|((i&4u)>>2u); }
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=8) return;
    uint span=2u<<uint(stageData.x), halfSpan=span/2u, j=i%halfSpan;
    uint a=(i/span)*span+j, b=a+halfSpan;
    if(stageData.x==0) { a=reverseThree(a);b=reverseThree(b); }
    float angle=-6.283185307179586*float(j)/float(span);
    vec2 twiddle=vec2(cos(angle),sin(angle)), v=inputData.values[b];
    vec2 product=vec2(twiddle.x*v.x-twiddle.y*v.y,twiddle.x*v.y+twiddle.y*v.x);
    outputData.values[i]=inputData.values[a]+(i%span<halfSpan?product:-product);
}
