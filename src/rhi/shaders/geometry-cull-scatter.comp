#version 450
#extension GL_GOOGLE_include_directive : require
#include "geometry-cull-parameters.glsl"
layout(local_size_x=64) in;
layout(set=1,binding=1,std430) readonly buffer CullIndices {uint sourceIndices[];};
layout(set=1,binding=2,std430) readonly buffer CullInputArguments {uint inputCount;uint inputInstances;uint inputFirst;int inputBase;uint inputInstance;};
layout(set=1,binding=3,std430) readonly buffer CullLocalOffsets {uint localOffsets[];};
layout(set=1,binding=4,std430) readonly buffer CullGroups {uint groupResults[];};
layout(set=1,binding=5,std430) writeonly buffer CullOutputIndices {uint outputIndices[];};
void main(){
    uint triangle=gl_GlobalInvocationID.x;if(triangle>=cullCounts.x)return;
    uint local=localOffsets[triangle];if(local==0xffffffffu)return;
    uint at=(groupResults[gl_WorkGroupID.x*2u+1u]+local)*3u;
    uint first=cullCounts.z!=0u?inputFirst:0u;
    for(uint i=0u;i<3u;++i)outputIndices[at+i]=sourceIndices[first+triangle*3u+i];
}
