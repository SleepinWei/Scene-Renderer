#version 450
#extension GL_GOOGLE_include_directive : require
#include "cluster-parameters.glsl"
layout(local_size_x=64) in;
layout(set=1,binding=1,std430) readonly buffer Clusters {GeometryCluster clusters[];};
layout(set=1,binding=2,std430) readonly buffer SourceIndices {uint sourceIndices[];};
layout(set=1,binding=3,std430) readonly buffer Offsets {uvec2 offsets[];};
layout(set=1,binding=4,std430) readonly buffer Groups {uvec2 groups[];};
layout(set=1,binding=5,std430) writeonly buffer OutputIndices {uint outputIndices[];};
void main(){uint id=gl_WorkGroupID.x;if(id>=clusterCounts.x)return;uvec2 o=offsets[id];uint base=groups[id/64u].x+o.x;
    for(uint i=gl_LocalInvocationIndex;i<o.y;i+=64u)if(base+i<clusterCounts.z)outputIndices[base+i]=sourceIndices[clusters[id].range.x+i];}
