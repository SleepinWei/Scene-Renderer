#version 450
#extension GL_GOOGLE_include_directive : require
#include "terrain-parameters.glsl"

#define PATCH_NUM 8
#define MAX_LEVEL 5

layout(local_size_x=PATCH_NUM,local_size_y=PATCH_NUM,local_size_z=1) in;

layout(set=1,binding=2,std140) readonly buffer FinalNodeList{
    uint finalNodeCnt;
    uint one;
    uint one_;
    uvec3 finalNode[];
};

struct Patch{
    vec4 Position[4];
    vec2 TexCoords[4];
};


layout(set=1,binding=0,std430) writeonly buffer GeneratedVertices {float packedVertices[];};
layout(set=1,binding=3,std430) writeonly buffer GeneratedIndices {uint generatedIndices[];};



layout(set=1,binding=7,rgba32f) readonly uniform image2D lodMap;


layout(set=1,binding=5,std430) buffer OutIndirect {
	uint count;
	uint primCount;
	uint firstIndex;
	uint baseVertex;
	int baseInstance;

};

void GetNearByLod(ivec3 curNode,int dir, out int lod){

    float totalNum = 5 * (1 << (MAX_LEVEL-curNode.z));
    ivec2 direction[4] = {
        ivec2(-1,0),ivec2(0,-1),ivec2(1,0),ivec2(0,1)
    };

    ivec2 texel;
    if(dir == 0 || dir == 1){
        texel = curNode.xy * (1 << curNode.z) + direction[dir];
    }else{
        texel = (curNode.xy + direction[dir]) * (1 << curNode.z);
    }
    lod = int(imageLoad(lodMap,clamp(texel,ivec2(0),imageSize(lodMap)-1)).r * MAX_LEVEL);

}

void main(){
    uvec2 localIndex = uvec2(gl_LocalInvocationID.xy);
    uint index = uint(gl_WorkGroupID.x);
    if(index>=finalNodeCnt)return;ivec3 curNode = ivec3(finalNode[index]);
    int curLod = curNode.z;
    float totalNum = 5 * (1 << (MAX_LEVEL-curNode.z));
    uint interval = 1 << (curLod);

    vec2 uv = vec2(curNode.xy) / float(totalNum);

    float delta = interval * 1.0f/ PATCH_NUM / 160.0f;

    Patch p;
    ivec2 offset[4] = {
        ivec2(0,0),
        ivec2(1,0),
        ivec2(1,1),
        ivec2(0,1)
    };

    for(int i =0 ;i<4;i++){
        vec2 currentPatchUV = uv + vec2(offset[i].x + localIndex.x , offset[i].y + localIndex.y) * delta;

        p.Position[i] = vec4(2 * currentPatchUV.x -1,0.0f,
            2*currentPatchUV.y -1,1.0f);
        p.TexCoords[i] = vec2(localIndex + offset[i]) / PATCH_NUM;
    }


    if(localIndex.x == 0 || localIndex.x == PATCH_NUM-1){
        int lod;
        int dir = (localIndex.x == 0 ? 0 :2);
        int loc1 = (localIndex.x == 0? 3 : 2);
        int loc2 = (localIndex.x == 0? 0:1);
        GetNearByLod(curNode,dir,lod);
        if(lod > curLod){

            if(localIndex.y % 2 == 0) {
                p.Position[loc1].z += 2 * delta;
                p.TexCoords[loc1].y += 1.0f/ PATCH_NUM;
            }else{
                p.Position[loc2].z += 2 * delta;
                p.TexCoords[loc2].y += 1.0f/PATCH_NUM;
            }
        }
    }
    if(localIndex.y ==0 || localIndex.y == PATCH_NUM-1){
        int lod;
        int dir = (localIndex.y == 0 ? 1 :3);
        int loc1 = (localIndex.y == 0? 1:2);
        int loc2 = (localIndex.y == 0? 0:3);
        GetNearByLod(curNode,dir,lod);
        if(lod > curLod){

            if(localIndex.x % 2 == 0) {
                p.Position[loc1].x -= 2 * delta;
                p.TexCoords[loc1].x -= 1.0f/ PATCH_NUM;
            }else{
                p.Position[loc2].x -= 2 * delta;
                p.TexCoords[loc2].x -= 1.0f/PATCH_NUM;
            }
        }
    }

    for(int i =0;i<4;i++){
        float height = sampleHeight(0.5 * p.Position[i].xz + 0.5);
        p.Position[i].y = height;
    }

    uint first=atomicAdd(count,6),base=first/6*4;
    for(uint i=0;i<4;i++){
        vec2 uv=.5*p.Position[i].xz+.5,step=1./vec2(heightDimensions.xy-1);
        float dx=(sampleHeight(uv+vec2(step.x,0))-sampleHeight(uv-vec2(step.x,0)))/(4.*step.x),dz=(sampleHeight(uv+vec2(0,step.y))-sampleHeight(uv-vec2(0,step.y)))/(4.*step.y);vec3 N=normalize(vec3(-dx,1,-dz));
        uint at=(base+i)*8;packedVertices[at]=p.Position[i].x;packedVertices[at+1]=p.Position[i].y;packedVertices[at+2]=p.Position[i].z;packedVertices[at+3]=N.x;packedVertices[at+4]=N.y;packedVertices[at+5]=N.z;packedVertices[at+6]=uv.x;packedVertices[at+7]=1.-uv.y;
    }
    uint order[6]={0,2,1,0,3,2};for(uint i=0;i<6;i++)generatedIndices[first+i]=base+order[i];
}
