#version 450
#extension GL_GOOGLE_include_directive : require
#include "ocean-parameters.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(rgba32f,set=1,binding=1) readonly uniform image2D InitialSpectrumRT;
layout(rgba32f,set=1,binding=2) writeonly uniform image2D HeightSpectrumRT;
const float PI=3.14159265359, G=9.81;
vec2 multiply(vec2 a,vec2 b){return vec2(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x);}
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,ivec2(N))))return;
    if(p.x==0||p.y==0||all(equal(p,ivec2(N/2)))){imageStore(HeightSpectrumRT,p,vec4(0));return;}
    float dk=2.*PI/OceanLength;
    float k=length(vec2(p-ivec2(N/2))*dk);
    float w=sqrt(G*k*(seaStateData.x>.5&&seaStateData.y>0.?tanh(k*seaStateData.y):1.));
    vec4 h=imageLoad(InitialSpectrumRT,p);
    float phase=w*Time;
    vec2 wave=multiply(h.xy,vec2(cos(phase),sin(phase)))+multiply(h.zw,vec2(cos(phase),-sin(phase)));
    imageStore(HeightSpectrumRT,p,vec4(wave*dk*float(N*N),0,0));
}
